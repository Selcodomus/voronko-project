@startuml
skinparam rectangle {
    BackgroundColor<<System>> #E3F2FD
}

rectangle "Покупець (Глядач)" as Buyer
rectangle "Організатор заходів" as Org
rectangle "Адміністратор" as Admin
rectangle "Система «EventTicket»" as Sys <<System>>
rectangle "Платіжний шлюз\n(Portmone / Apple Pay)" as Pay
rectangle "Email-сервіс" as Email

Buyer --> Sys : пошук подій, оплата, перегляд квитків
Org --> Sys : створення подій, сканування QR-кодів
Admin --> Sys : управління платформою
Sys --> Pay : запит на транзакцію
Pay --> Sys : підтвердження статусу оплати
Sys --> Email : відправлення листів (відновлення пароля)
@enduml
